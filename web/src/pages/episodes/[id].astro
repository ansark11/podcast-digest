---
import sanitizeHtml from 'sanitize-html';
import Base from '../../layouts/Base.astro';
import Thumb from '../../components/Thumb.astro';
import Icon from '../../components/Icon.astro';
import {
  getEpisodes, splitTitle, guestName, formatDate, formatDuration, readMinutes, listenUrl, type Summary,
} from '../../lib/episodes';

export async function getStaticPaths() {
  const episodes = await getEpisodes();
  return episodes.map((episode, i) => ({
    params: { id: episode.id },
    // "Up next" = the next two older episodes, wrapping to the newest.
    props: { episode, upNext: [1, 2].map((k) => episodes[(i + k) % episodes.length]).filter((e) => e.id !== episode.id) },
  }));
}

interface Props { episode: Summary; upNext: Summary[]; }
const { episode, upNext } = Astro.props;
const d = episode.data;
const s = d.summary;
const { headline, guest } = splitTitle(d.episode_title);
const duration = formatDuration(d.duration_seconds);
const listen = listenUrl(episode);
const minutes = readMinutes(episode);
// Show notes come from the feed as HTML; keep only safe formatting and links.
const notesHtml = d.description_html
  ? sanitizeHtml(d.description_html, {
      allowedTags: ['p', 'br', 'a', 'strong', 'b', 'em', 'i', 'ul', 'ol', 'li', 'h2', 'h3', 'h4', 'blockquote'],
      allowedAttributes: { a: ['href'] },
      transformTags: { a: sanitizeHtml.simpleTransform('a', { target: '_blank', rel: 'noopener noreferrer' }) },
    })
  : null;
const KIND_LABEL: Record<string, string> = { book: 'Book', tool: 'Tool', product: 'Product', company: 'Company', show: 'Show', article: 'Article', person: 'Person', other: 'Other' };
const toc = [
  { id: 'overview', label: 'Overview', n: null },
  { id: 'takeaways', label: 'Key takeaways', n: s.takeaways.length },
  ...(s.quotes.length ? [{ id: 'quotes', label: 'Quotes', n: s.quotes.length }] : []),
  ...(s.resources.length ? [{ id: 'resources', label: 'Resources', n: s.resources.length }] : []),
  ...(notesHtml ? [{ id: 'show-notes', label: 'Show notes', n: null }] : []),
];
---
<Base title={`${headline} · Digest`} active="library" description={s.overview}>
  <div class="reader" data-reader data-id={episode.id}>
    <a class="back muted" href="/"><Icon name="chevron-left" size={16} />Library</a>

    <header class="hero card">
      <Thumb episode={episode} size={140} radius={22} />
      <div class="hero-body">
        <span class="kicker">{d.show} · {formatDate(d.published, true)}{duration && ` · ${duration}`}</span>
        <h1>{headline}</h1>
        {guest && <span class="muted guest">{guest}</span>}
        <div class="actions">
          {listen && (
            <a class="btn btn-primary" href={listen} target="_blank" rel="noopener noreferrer">
              <Icon name="play" size={16} />Listen<span class="long"> to episode</span>
            </a>
          )}
          <button type="button" class="btn" data-save aria-pressed="false">
            <Icon name="bookmark" size={16} /><span data-save-label>Save</span>
          </button>
          {notesHtml && <a class="btn" href="#show-notes">Show notes</a>}
        </div>
      </div>
    </header>

    <div class="columns">
      <article class="article">
        <section id="overview" class="card block" data-section>
          <h2 class="eyebrow">Overview</h2>
          <p class="overview">{s.overview}</p>
        </section>

        <section id="takeaways" class="card block" data-section>
          <div class="block-head">
            <h2 class="eyebrow">Key takeaways</h2>
            <span class="muted small">{s.takeaways.length} total</span>
          </div>
          <ol class="takeaways">
            {s.takeaways.map((t, i) => (
              <li>
                <span class="num" aria-hidden="true">{i + 1}</span>
                <div>
                  {t.heading && <h3>{t.heading}</h3>}
                  <p>{t.detail}</p>
                </div>
              </li>
            ))}
          </ol>
        </section>

        {s.quotes.length > 0 && (
          <section id="quotes" class="card block" data-section>
            <h2 class="eyebrow">Notable quotes</h2>
            <div class="quotes">
              {s.quotes.map((q) => (
                <figure class="quote">
                  <span class="quote-mark"><Icon name="quote" size={26} /></span>
                  <blockquote>{q.text}</blockquote>
                  {q.speaker && <figcaption>{q.speaker}</figcaption>}
                </figure>
              ))}
            </div>
          </section>
        )}

        {s.resources.length > 0 && (
          <section id="resources" class="card block" data-section>
            <h2 class="eyebrow">Resources mentioned</h2>
            <ul class="resources">
              {s.resources.map((r) => (
                <li><span class={`kind kind-${r.kind}`}>{KIND_LABEL[r.kind] ?? r.kind}</span>{r.name}</li>
              ))}
            </ul>
          </section>
        )}

        {notesHtml && (
          <section id="show-notes" class="card block" data-section>
            <details>
              <summary class="eyebrow">Show notes from the publisher</summary>
              <div class="notes" set:html={notesHtml} />
            </details>
          </section>
        )}

        <p class="meta muted small">Summary generated {formatDate(d.generated_at, true)} · {d.summary_model} · prompt {d.prompt_version}</p>
      </article>

      <aside class="aside">
        <nav class="card toc" aria-label="On this page">
          <span class="eyebrow">On this page</span>
          {toc.map((t) => (
            <a href={`#${t.id}`} data-toc={t.id}>{t.label}{t.n !== null && <span class="muted">{t.n}</span>}</a>
          ))}
          <hr />
          <div class="toc-progress">
            <span class="progress"><span data-read-bar style="width:0%"></span></span>
            <span class="small muted">{minutes} min read</span>
          </div>
        </nav>

        {upNext.length > 0 && (
          <section class="card upnext">
            <h2 class="eyebrow">Up next</h2>
            {upNext.map((n) => {
              const t = splitTitle(n.data.episode_title);
              return (
                <a href={`/episodes/${n.id}`}>
                  <Thumb episode={n} size={48} radius={12} />
                  <span class="upnext-body">
                    <span class="upnext-title">{t.headline}</span>
                    <span class="muted small">{guestName(t.guest) ?? n.data.show} · {formatDate(n.data.published)}</span>
                  </span>
                </a>
              );
            })}
          </section>
        )}
      </aside>
    </div>
  </div>
</Base>

<style>
  .reader { display: flex; flex-direction: column; gap: 24px; }
  .small { font-size: 13px; }
  .back { display: inline-flex; align-items: center; gap: 6px; font-size: 14px; font-weight: 600; text-decoration: none; align-self: flex-start; min-height: 32px; }
  .hero { display: flex; gap: 28px; align-items: center; padding: 28px; }
  .hero-body { display: flex; flex-direction: column; gap: 10px; min-width: 0; }
  .kicker { font-size: 13px; font-weight: 700; color: var(--accent-ink); text-transform: uppercase; letter-spacing: 0.8px; }
  h1 { margin: 0; font-size: 30px; line-height: 1.2; font-weight: 800; letter-spacing: -0.5px; }
  .guest { font-size: 15px; }
  .actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 6px; }
  .columns { display: flex; gap: 28px; align-items: flex-start; }
  .article { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 20px; }
  .block { padding: 28px 32px; display: flex; flex-direction: column; gap: 14px; }
  .block h2 { margin: 0; }
  .block-head { display: flex; align-items: baseline; justify-content: space-between; }
  .overview { margin: 0; font-size: 18px; line-height: 1.65; font-weight: 500; }
  .takeaways { list-style: none; margin: 0; padding: 0; }
  .takeaways li { display: flex; gap: 16px; padding: 16px 0; border-top: 1px solid var(--divider); }
  .num { width: 30px; height: 30px; flex-shrink: 0; border-radius: 10px; background: var(--accent-soft); color: var(--accent-ink); font-size: 13px; font-weight: 800; display: grid; place-items: center; }
  .takeaways h3 { margin: 0 0 4px; font-size: 16px; font-weight: 700; }
  .takeaways p { margin: 0; font-size: 15px; line-height: 1.7; color: var(--text-2); }
  .quotes { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .quote { margin: 0; padding: 22px; border-radius: var(--radius-md); background: var(--quote-bg); display: flex; flex-direction: column; gap: 12px; }
  .quote-mark { color: var(--warm); display: flex; }
  .quote blockquote { margin: 0; font-size: 18px; line-height: 1.45; font-weight: 700; color: var(--quote-ink); }
  .quote figcaption { font-size: 13px; font-weight: 600; color: var(--quote-cap); }
  .resources { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .resources li { display: flex; align-items: center; gap: 8px; padding: 10px 14px; border-radius: var(--radius-sm); background: var(--chip); font-size: 14px; font-weight: 600; }
  .kind { font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.6px; color: var(--kind-other); }
  .kind-book, .kind-article { color: var(--kind-book); }
  .kind-tool { color: var(--kind-tool); }
  .kind-product, .kind-company { color: var(--kind-product); }
  .kind-show, .kind-person { color: var(--kind-show); }
  details summary { cursor: pointer; }
  .notes { margin-top: 14px; font-size: 15px; line-height: 1.65; color: var(--text-2); overflow-wrap: anywhere; }
  .notes :global(a) { color: var(--accent-ink); }
  .meta { margin: 4px 0 0; }
  .aside { width: 272px; flex-shrink: 0; position: sticky; top: 24px; display: flex; flex-direction: column; gap: 20px; }
  .toc { padding: 22px; display: flex; flex-direction: column; gap: 4px; }
  .toc .eyebrow { margin-bottom: 8px; }
  .toc a { display: flex; justify-content: space-between; padding: 10px 12px; border-radius: 10px; color: var(--text); text-decoration: none; font-size: 14px; font-weight: 600; }
  .toc a:hover { background: var(--surface-2); }
  .toc a.active { background: var(--accent-soft); color: var(--accent-ink); font-weight: 700; }
  .toc hr { border: 0; height: 1px; background: var(--divider); margin: 10px 0; width: 100%; }
  .toc-progress { display: flex; align-items: center; gap: 10px; }
  .upnext { padding: 22px; display: flex; flex-direction: column; gap: 14px; }
  .upnext h2 { margin: 0; }
  .upnext a { display: flex; gap: 12px; align-items: center; text-decoration: none; color: var(--text); }
  .upnext-body { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .upnext-title { font-size: 14px; font-weight: 700; line-height: 1.3; }
  @media (max-width: 1100px) {
    .columns { flex-direction: column; }
    .aside { width: 100%; position: static; }
    .toc { display: none; }
  }
  @media (max-width: 700px) {
    .hero { flex-direction: column; align-items: flex-start; padding: 20px; gap: 18px; }
    h1 { font-size: 24px; }
    .block { padding: 22px 18px; }
    .overview { font-size: 17px; }
    .quotes { grid-template-columns: minmax(0, 1fr); }
    .actions .btn { flex: 1; justify-content: center; }
    .long { display: none; }
    .hero :global(.thumb) { width: 88px !important; height: 88px !important; border-radius: 16px !important; }
  }
</style>

<script>
  import { markOpened, setProgress, toggleSaved, load } from '../../lib/store';

  const reader = document.querySelector<HTMLElement>('[data-reader]');
  if (reader) {
    const id = reader.dataset.id!;
    markOpened(id);

    // Save toggle
    const btn = reader.querySelector<HTMLButtonElement>('[data-save]')!;
    const label = btn.querySelector('[data-save-label]')!;
    const render = (on: boolean) => { btn.setAttribute('aria-pressed', String(on)); label.textContent = on ? 'Saved' : 'Save'; };
    render(load().saved.includes(id));
    btn.addEventListener('click', () => {
      const on = toggleSaved(id);
      render(on);
      document.querySelectorAll<HTMLElement>('[data-saved-count]').forEach((el) => {
        const n = load().saved.length; el.textContent = n ? String(n) : '';
      });
    });

    // Reading progress: how far through the article you've scrolled
    const article = reader.querySelector<HTMLElement>('.article')!;
    const bar = reader.querySelector<HTMLElement>('[data-read-bar]');
    let best = load().progress[id] ?? 0;
    const onScroll = () => {
      const rect = article.getBoundingClientRect();
      const total = rect.height - window.innerHeight * 0.6;
      const p = total <= 0 ? 1 : Math.min(1, Math.max(0, -rect.top / total));
      if (bar) bar.style.width = `${Math.round(p * 100)}%`;
      if (p > best + 0.02 || (p >= 0.99 && best < 1)) { best = p; setProgress(id, p); }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // Highlight the section you're reading in "On this page"
    const links = new Map([...reader.querySelectorAll<HTMLAnchorElement>('[data-toc]')].map((a) => [a.dataset.toc!, a]));
    const obs = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          links.forEach((a) => a.classList.remove('active'));
          links.get(e.target.id)?.classList.add('active');
        }
      });
    }, { rootMargin: '-20% 0px -70% 0px' });
    reader.querySelectorAll('[data-section]').forEach((sec) => obs.observe(sec));
  }
</script>
