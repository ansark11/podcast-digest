---
import Base from '../layouts/Base.astro';
import EpisodeList from '../components/EpisodeList.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Library · Digest" active="library">
  <header class="page-head">
    <div class="page-title">
      <h1>Library</h1>
      <p class="muted">Every episode summary, newest first</p>
    </div>
    <label class="search">
      <Icon name="search" />
      <span class="visually-hidden">Search summaries</span>
      <input type="search" data-search-input placeholder="Search titles, guests, takeaways" autocomplete="off" />
      <kbd>/</kbd>
    </label>
  </header>
  <EpisodeList mode="library" />
</Base>

<style>
  .page-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
  .page-title { display: flex; flex-direction: column; gap: 6px; }
  h1 { margin: 0; font-size: 32px; font-weight: 800; letter-spacing: -0.6px; }
  p { margin: 0; font-size: 15px; }
  .search { display: flex; align-items: center; gap: 10px; width: 360px; max-width: 100%; height: 48px; padding: 0 16px; background: var(--surface); border-radius: 14px; border: 1px solid var(--border-strong); color: var(--muted); }
  .search:focus-within { border-color: var(--accent); }
  .search input { border: 0; outline: none; flex: 1; min-width: 0; font-size: 15px; background: transparent; color: var(--text); }
  kbd { font: inherit; font-size: 12px; font-weight: 700; border: 1px solid var(--border-strong); border-radius: 6px; padding: 1px 6px; }
  @media (max-width: 900px) { .search { width: 100%; } kbd { display: none; } h1 { font-size: 28px; } }
</style>
